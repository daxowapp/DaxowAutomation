# Contact form email delivery (https://resend.com)
# Required in production for the /contact form to email leads automatically.
# Without it, the form falls back to opening the visitor's email app pre-filled to ahmed@daxow.com.
RESEND_API_KEY=

# Where leads are delivered (defaults to ahmed@daxow.com)
CONTACT_TO_EMAIL=ahmed@daxow.com

# Sender address. Must be on a domain verified in Resend (e.g. daxow.com).
# The default onboarding@resend.dev only delivers to the Resend account owner's email.
CONTACT_FROM_EMAIL=Daxow Website <website@daxow.com>
